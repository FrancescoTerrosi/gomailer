# gomailer systemd unit — THE daemon: the single process that fires jobs.
#
# Install / upgrade:  sudo ./install.sh  — the RUNBOOK §2 sequence in one
# command; idempotent (a running daemon is restarted to pick up the new
# binary, draining in-flight sends first).
# Uninstall:          sudo ./uninstall.sh — keeps /var/lib/gomailer (the
# evidence store) unless --purge-state.
#
# The daemon loads the store at boot and re-arms every pending job: a reboot
# BEFORE a job's FireAt costs nothing (it still fires exactly on time); only
# a machine down AT the fire time triggers catch-up, logged "FIRED <delay>
# LATE". Scheduling clients (gomailer -at/-in ...) submit to the daemon
# over its control socket and never send anything themselves, so there is
# exactly one sending process — a second daemon on the same store is refused
# by the run lock, as is a manual resume while the daemon owns the store.
#
# Stopping is graceful: jobs already inside their warmup window or mid-send
# run to completion (bounded by -lead, default 5s); jobs still waiting stay
# pending in the store and re-arm at the next start.

[Unit]
Description=gomailer — PEC scheduling daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# The gomailer system user/group is created from gomailer.sysusers.conf
# (see the install lines above). The store and control socket are 0600 and
# owner-only, so scheduling clients must run as this same user:
#   sudo -u gomailer env PEC_PASSWORD=... gomailer -in 2m ...
User=gomailer
Group=gomailer

# systemd creates /var/lib/gomailer for us (0700, owned by the service
# user), so no manual mkdir/chown is needed. The daemon writes only here.
StateDirectory=gomailer
StateDirectoryMode=0700

ExecStart=/usr/local/bin/gomailer -daemon -store /var/lib/gomailer/jobs.json

# The daemon carries no credentials (jobs do) — the file is optional, and
# a missing one must not stop the unit. Add PEC_PASSWORD=... only if you
# want the daemon's own environment to carry it (it does not use it).
EnvironmentFile=-/etc/gomailer.env

Restart=on-failure
RestartSec=2

# How long `systemctl stop` waits before SIGKILL. Pinned at the default
# deliberately: RUNBOOK §8 documents that a send wedged on an unresponsive
# provider blocks the graceful stop (the SMTP session carries no read/write
# deadlines), and a kill turns that send into the crash-during-send case
# (RUNBOOK §7) — boot flags it for manual verification, never auto-resent.
TimeoutStopSec=90s

# --- Sandbox ----------------------------------------------------------------
# The daemon's entire footprint is the state dir: store, payload blobs,
# lock sidecars and control socket all live under /var/lib/gomailer
# (StateDirectory= above),
# which stays writable under ProtectSystem=strict. Attachment bytes arrive
# embedded in socket requests and are persisted to the store — the daemon
# never reads operator files — so a read-only root costs nothing. The wire
# side is exactly: one Unix socket plus outbound TCP to the PEC provider
# and its DNS resolvers.
# Needs systemd >= 247 (Debian 11+, Ubuntu 22.04+); older versions ignore
# directives they do not know, but syscall-filter coverage differs.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# flock is a DIRECT member of @system-service since systemd 247 — verified
# against that release's source — but it is listed explicitly anyway: the
# store's run/mutation locks (internal/jobber) are the one-daemon
# guarantee, and that must never depend on a filter revision.
SystemCallFilter=@system-service flock

# 0077 so freshly created files are owner-only from the first instant: the
# control socket between bind and its explicit chmod 0600 (the bind→chmod
# window), the lock sidecars, the store temp files. The gomailer user never
# needs a broader umask.
UMask=0077

# Deliberately NOT set: PrivateUsers= and DynamicUser= would map the
# service onto throwaway UIDs. Scheduling clients reach the 0600 control
# socket only by running as the SAME persistent gomailer user, and the
# store must keep one owner across reboots — the owner-only permission
# model IS the security boundary here.

[Install]
WantedBy=multi-user.target
