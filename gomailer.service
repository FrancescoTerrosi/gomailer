# gomailer systemd unit — THE daemon: the single process that fires jobs.
#
# Install:
#   sudo install -m755 gomailer /usr/local/bin/gomailer
#   sudo mkdir -p /var/lib/gomailer
#   sudo install -m600 /dev/null /etc/gomailer.env   # then add PEC_PASSWORD=...
#   sudo systemctl enable --now gomailer
#
# The daemon loads the store at boot and re-arms every pending job: a reboot
# BEFORE a job's FireAt costs nothing (it still fires exactly on time); only
# a machine down AT the fire time triggers catch-up, logged "FIRED <delay>
# LATE". Scheduling clients (gomailer -at/-in ...) submit to the daemon
# over its control socket and never send anything themselves, so there is
# exactly one sending process — a second daemon on the same store is refused
# by the run lock, as is a manual resume while the daemon owns the store.
#
# Stopping is graceful: jobs already inside their warmup window or mid-send
# run to completion (bounded by -lead, default 5s); jobs still waiting stay
# pending in the store and re-arm at the next start.

[Unit]
Description=gomailer — PEC scheduling daemon
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/gomailer -daemon -store /var/lib/gomailer/jobs.json
EnvironmentFile=/etc/gomailer.env
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target